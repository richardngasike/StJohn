# ============================================================
# St Johns Training College — Frontend Environment Variables
# File: frontend/.env.local
# ============================================================

# ── API ──────────────────────────────────────────────────────
# Development (local backend)
NEXT_PUBLIC_API_URL=http://localhost:5000/api

# Production (uncomment when deploying)
# NEXT_PUBLIC_API_URL=https://api.stjohnscollege.ac.ke/api

# ── Site URL ─────────────────────────────────────────────────
# Development
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Production (uncomment when deploying)
# NEXT_PUBLIC_SITE_URL=https://www.stjohnscollege.ac.ke

# ── College Info ─────────────────────────────────────────────
NEXT_PUBLIC_COLLEGE_NAME=St Johns Training College
NEXT_PUBLIC_COLLEGE_PHONE=+254 700 000 000
NEXT_PUBLIC_COLLEGE_EMAIL=info@stjohnscollege.ac.ke
NEXT_PUBLIC_COLLEGE_ADDRESS=123 College Road, Nairobi, Kenya
NEXT_PUBLIC_COLLEGE_PO_BOX=P.O. Box 00100, Nairobi

# ── Social Media ─────────────────────────────────────────────
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/stjohnscollege
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/stjohnscollege
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/stjohnscollege
NEXT_PUBLIC_YOUTUBE_URL=https://youtube.com/stjohnscollege
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/stjohnscollege

# ── Auth ─────────────────────────────────────────────────────
NEXTAUTH_SECRET=stjohns_nextauth_secret_change_in_production_2024
NEXTAUTH_URL=http://localhost:3000

# ── Donation Bank Account ─────────────────────────────────────
NEXT_PUBLIC_BANK_NAME=KCB Bank
NEXT_PUBLIC_BANK_SWIFT=KCBLKENX
NEXT_PUBLIC_BANK_ACCOUNT=1204223807

# ── Feature Flags ────────────────────────────────────────────
NEXT_PUBLIC_ENABLE_DONATIONS=true
NEXT_PUBLIC_ENABLE_PORTAL=true
